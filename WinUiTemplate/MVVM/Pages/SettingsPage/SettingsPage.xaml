<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="WinUiTemplate.MVVM.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:community="using:CommunityToolkit.WinUI.Controls"
      xmlns:converters="using:WinUiTemplate.MVVM.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:WinUiTemplate.MVVM.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="using:CommunityToolkit.WinUI"
      mc:Ignorable="d">
    <Page.Resources>
        <converters:TrueToVisibleConverter x:Key="trueToVisibleConverter" />
        <converters:BoolToRevealConverter x:Key="boolToRevealConverter" />
        <converters:ColourToHexConverter x:Key="colourToHexConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="9" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer>
            <ItemsRepeater x:Name="expandersContainer"
                           ItemsSource="{Binding SettingsCategories}"
                           Margin="16">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical"
                                 Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <community:SettingsExpander Header="{Binding Category}"
                                                    ItemsSource="{Binding Settings}">
                            <community:SettingsExpander.ItemTemplate>
                                <DataTemplate>
                                    <community:SettingsCard Header="{Binding Name}"
                                                            Description="{Binding Description}"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource trueToVisibleConverter}}">
                                        <community:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="{Binding Icon}" />
                                        </community:SettingsCard.HeaderIcon>
                                        <community:SwitchPresenter Value="{Binding Type}">

                                            <community:Case Value="System.Boolean">
                                                <ToggleSwitch IsOn="{Binding Value, Mode=TwoWay}" />
                                            </community:Case>

                                            <community:Case Value="System.String">
                                                <TextBox Text="{Binding Value, Mode=TwoWay}" />
                                            </community:Case>

                                            <community:Case Value="Encrypted">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <PasswordBox Password="{Binding Value, Mode=TwoWay}"
                                                                 PasswordRevealMode="{Binding ShowDecrypted, Converter={StaticResource boolToRevealConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ToggleButton IsChecked="{Binding ShowDecrypted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <FontIcon Glyph="&#xE890;" />
                                                    </ToggleButton>
                                                </StackPanel>
                                            </community:Case>

                                            <community:Case Value="Windows.UI.Color">
                                                <community:ColorPickerButton SelectedColor="{Binding Value, Mode=TwoWay}" />
                                            </community:Case>

                                            <community:Case Value="Enum">
                                                <ComboBox ItemsSource="{Binding Names}"
                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                            </community:Case>

                                            <community:Case Value="Comparable">
                                                <NumberBox Value="{Binding Value, Mode=TwoWay}"
                                                           Minimum="{Binding Min}"
                                                           Maximum="{Binding Max}"
                                                           LargeChange="1"
                                                           SmallChange="1"
                                                           SpinButtonPlacementMode="Inline" />
                                            </community:Case>

                                            <community:Case Value="Button">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <ProgressRing IsActive="True"
                                                                  Visibility="{Binding LoaderVisibility}" />
                                                    <Button Content="{Binding ButtonText}"
                                                            Command="{Binding ExecuteButtonActionCommand}" />
                                                </StackPanel>
                                            </community:Case>

                                            <community:Case Value="FilePath">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <TextBox x:Uid="SettingsPage/PathTextBox"
                                                             Text="{Binding Value, Mode=TwoWay}" />
                                                    <Button x:Uid="SettingsPage/BrowseButton"
                                                            Command="{Binding ExecuteButtonActionCommand}" />
                                                </StackPanel>
                                            </community:Case>

                                            <community:Case Value="WinUiTemplate.Core.MVVM.Models.GradientStep">
                                                <StackPanel Orientation="Horizontal" 
                                                            Spacing="8">
                                                    <community:ColorPickerButton SelectedColor="{Binding Value.Colour, Mode=TwoWay, Converter={StaticResource colourToHexConverter}}"/>
                                                    <NumberBox Value="{Binding Value.PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Minimum="0"
                                                               Maximum="1"
                                                               PlaceholderText="0.0 ≤ X ≤ 1.0"/>
                                                    <NumberBox Value="{Binding Value.PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Minimum="0"
                                                               Maximum="1"
                                                               PlaceholderText="0.0 ≤ Y ≤ 1.0"/>
                                                    <NumberBox Value="{Binding Value.Offset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Minimum="0"
                                                               Maximum="1"
                                                               PlaceholderText="0.0 ≤ Offset ≤ 1.0"/>
                                                </StackPanel>
                                            </community:Case>

                                        </community:SwitchPresenter>
                                    </community:SettingsCard>
                                </DataTemplate>
                            </community:SettingsExpander.ItemTemplate>
                        </community:SettingsExpander>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <Rectangle Height="1"
                   Grid.Row="1"
                   Margin="16,8,16,0"
                   VerticalAlignment="Bottom"
                   Fill="Gray" />
        <Button x:Uid="SettingsPage/RestoreDefaultsButton"
                Grid.Row="2"
                Margin="16,8"
                HorizontalAlignment="Right"
                Command="{Binding RestoreDefaultsCommand}" />
    </Grid>
</Page>
